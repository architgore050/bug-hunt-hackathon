# Bug Hunt CTF backend environment template.
#
# Copy to backend/.env and fill in real values. backend/.env is gitignored and
# must never be committed. Values map to backend/app/config.py; every setting
# below is optional in development (config.py supplies clearly marked dev-only
# defaults), but a live deployment MUST override the secrets.
#
# This file is a template only: it contains placeholders, never real secrets.

# --- deployment profile ------------------------------------------------------
PROFILE=d0-local                 # d0-local | d1-free-vm
ENVIRONMENT=development          # development | production

# --- database ----------------------------------------------------------------
# The participant/admin API connects as app_api, which CANNOT read the gt schema.
DATABASE_URL_APP=postgresql+psycopg://app_api:CHANGE_ME_APP_API_PASSWORD@127.0.0.1:5434/bughunt
# Only the evaluator / ground-truth code paths use this restricted connection.
DATABASE_URL_GT=postgresql+psycopg://gt_admin:CHANGE_ME_GT_ADMIN_PASSWORD@127.0.0.1:5434/bughunt
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4

# Database role password, kept here for safekeeping only.
# backend/app/config.py does NOT read this variable (extra="ignore"); the
# passwords the code actually uses are the ones embedded in the two URLs above.
# Record it so the credential is not lost, and keep the filled-in file local.
# In production set a real non-dev password here and in both URLs above.
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- auth --------------------------------------------------------------------
# Generate a fresh 32+ byte secret for every real deployment:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256              # pinned; HS256 only
ACCESS_TOKEN_TTL_S=600
REFRESH_TOKEN_TTL_S=259200
REFRESH_REUSE_GRACE_S=10
COOKIE_DOMAIN=                   # empty = host-only cookie
MAX_SESSIONS_PER_USER=2
PASSWORD_MIN_LENGTH=12

# --- limits (server-side, authoritative) -------------------------------------
MAX_BODY_BYTES=524288
SUBMISSION_MAX_DESC_CHARS=2000
MAX_CONCURRENT_REQUESTS_PER_USER=20

# --- feature switches (kill switches) ----------------------------------------
RUNNER_ENABLED=false
AI_ASSESSMENT_ENABLED=false
TELEMETRY_ENABLED=false

# --- observability -----------------------------------------------------------
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173   # exact CORS allow-list entry; comma-separated for more
